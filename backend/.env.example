# LANDVILLA backend environment – copy to backend/.env and fill in. NEVER commit backend/.env.
# All values below are placeholders.

# MongoDB connection string. Local dev: mongodb://localhost:27017
# Production: your own MongoDB Atlas (or self-hosted) URI with a dedicated user + TLS.
MONGO_URL=mongodb://localhost:27017
# Database name (any name; keep the same name when restoring a dump)
DB_NAME=landvilla_dev

# Comma-separated Google account emails that become admins on sign-in
ADMIN_EMAILS=admin@yourcompany.example

# Public base URL of the backend (used for sitemap, canonical links, legal pages)
PUBLIC_BASE_URL=https://api.yourcompany.example

# Demo/test data switches. MUST be "false" in production.
# SEED_DEMO_LISTINGS=true -> inserts fictional demo listings (preview/dev only)
# SEED_TEST_SESSIONS=true -> enables fixed "test_session_*" bearer tokens (dev/testing only)
SEED_DEMO_LISTINGS=false
SEED_TEST_SESSIONS=false

# Razorpay. Use rzp_test_* keys everywhere except the production server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_key_secret
# Secret you set on the Razorpay Dashboard webhook for /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Emergent-managed object storage (listing photos, broker documents). Read ONLY when a file is uploaded;
# the backend starts without them, but uploads return 500. See docs/INTEGRATIONS_SETUP.md section 2.
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
EMERGENT_LLM_KEY=replace_only_if_you_keep_emergent_storage

# Explicit environment and non-destructive startup (production must disable demos/test sessions).
APP_ENV=development
SEED_ON_STARTUP=false
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8001
# Exact browser origins; production requires explicit HTTPS same-site origins.
WEB_APP_ORIGINS=http://localhost:8081,http://localhost:19006
STORAGE_PROVIDER=emergent
ALLOW_LIVE_PAYMENTS=false

# Enable only after applying identity indexes explicitly on the intended database.
IDENTITY_ENABLED=false
OTP_HMAC_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated company-owned OAuth client audiences (public IDs, not secrets).
GOOGLE_CLIENT_IDS=

# Google Play one-time featured products. Keep disabled until license-test acceptance.
GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.landvilla.app
# Absolute path to a privately provisioned service-account credential file, or use workload identity.
GOOGLE_APPLICATION_CREDENTIALS=
# Exact authenticated Pub/Sub push audience and sender service-account email.
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=
# Full Razorpay refunds require approved refund policy and independent admin review.
REFUNDS_ENABLED=false
