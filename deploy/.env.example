# Operator TEMPLATE ONLY. Actual copy contains dedicated proxy credentials: mode 0600.
# Copy outside the repository, never into an image or terminal output.
# Fill verified values; empty required fields intentionally prevent Compose startup.
LANDVILLA_ENV_FILE=
LANDVILLA_DOCKER_SUBNET=
LANDVILLA_DOCKER_DYNAMIC_RANGE=
LANDVILLA_WEB_PROXY_IP=
LANDVILLA_API_IMAGE=
LANDVILLA_WEB_IMAGE=
LANDVILLA_CADDY_IMAGE=
LANDVILLA_ACME_EMAIL=
# Public OAuth web audience compiled into the Web image (not a secret).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Distinct cryptographically random 32-byte hex values, securely provisioned outside Git.
# Caddy/Web share first; Web/API share second. No database or storage credentials here.
LANDVILLA_INGRESS_TOKEN=
LANDVILLA_WEB_API_IP_KEY=
