# Server-only, fixed backend origin. Never expose credentials or Mongo/R2 config here.
BACKEND_ORIGIN=http://127.0.0.1:8000
# Must also be accepted by the existing backend WEB_APP_ORIGINS.
# 19006 is an existing backend development default; no backend edit is required.
WEB_ORIGIN=http://localhost:19006
# Public Google OAuth web audience, NOT a secret. Leave blank to disable Google UI.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Production: WEB_ORIGIN=https://landvilla.in is mandatory. By default the
# backend also requires HTTPS. The only private HTTP exception is exactly:
# BACKEND_ORIGIN=http://api:8000
# BACKEND_TRANSPORT=private-http
# This exception requires the reviewed Docker network and trusted web proxy IP.
