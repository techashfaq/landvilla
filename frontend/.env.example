# LANDVILLA mobile app environment – copy to frontend/.env. NEVER commit frontend/.env.
# Only EXPO_PUBLIC_* values are bundled into the app. NEVER put secrets here: anything
# EXPO_PUBLIC_* is readable by anyone who downloads the APK/AAB.

# Base URL of the backend WITHOUT the trailing /api (the app appends /api itself).
#  - Android emulator talking to backend on your PC:  http://10.0.2.2:8001
#  - Physical phone on same Wi-Fi:                    http://<your-PC-LAN-IP>:8001
#  - Release build:                                   https://api.yourcompany.example
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8001

# The following are Emergent preview-only variables. Do NOT set them on your machine:
# EXPO_PACKAGER_PROXY_URL, EXPO_PACKAGER_HOSTNAME, EXPO_TUNNEL_SUBDOMAIN, METRO_CACHE_ROOT
